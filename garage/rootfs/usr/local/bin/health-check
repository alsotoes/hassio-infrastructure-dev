#!/command/with-contenv bash
# shellcheck shell=bash

# Health check for Garage S3 API endpoint
# Returns 0 if healthy (server responds), 1 if unhealthy
# Note: Garage requires auth for /health, so 403 means server is up

set -euo pipefail

HEALTH_ENDPOINT="http://127.0.0.1:3900/health"
TIMEOUT=3

# Check if server responds (even 403 means server is up and handling requests)
# Use curl with -f to fail on 4xx/5xx, but we want to accept 403 as "server is up"
HTTP_CODE=$(curl -s -o /dev/null -w "%{http_code}" --max-time "${TIMEOUT}" "${HEALTH_ENDPOINT}" 2>/dev/null || echo "000")

# Server is healthy if it responds with any HTTP code (200, 403, etc.)
# 000 means connection failed
if [ "${HTTP_CODE}" != "000" ]; then
    exit 0
else
    exit 1
fi